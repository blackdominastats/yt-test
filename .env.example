# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Only placeholder values belong here. Real keys go in .env.local (gitignored)
# or in /opt/sloptube/.env on the server. Every setting is read on the server
# at request time, so one build or Docker image works with any values.
#
# Everything is optional. With nothing filled in the app still runs and shows
# "database not connected" (and `npm run dev` shows previews of the pages).

# --- Supabase (the database and sign in) -------------------------------------
# Your project's URL and publishable key, from the project's API keys page
# (https://supabase.com/dashboard/project/_/settings/api-keys). Both are public
# by design: they end up in the browser, and row level security protects the
# data. Set both or neither.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Set to 1 to show the read only /flags page in production.
# It is always on with `npm run dev`.
FLAGS_PAGE=

# --- Supabase Storage S3 (video uploads, feature 3) ---------------------------
# Server only, never NEXT_PUBLIC. Generate S3 credentials in Storage > Configuration > S3.
# They have full access to project Storage buckets and bypass Storage RLS.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=sloptube-videos

# Optional. A public domain connected to the video bucket, for example
# https://media.example.com. When set, the player loads videos straight from
# it instead of through /api/media. See "Watch page" in docs/features.md first:
# anything under hls/ is then public to whoever has the link.
MEDIA_PUBLIC_URL=

# --- The site ----------------------------------------------------------------
# Optional. This site's address, like https://tube.example.com, for canonical
# links, share cards and sitemap.xml. Without it the address the browser asked
# for is used (what the reverse proxy passes on).
SITE_URL=

# (GIT_SHA, the commit /api/version shows, is set by the Docker build.)

# --- Sign in with Yapin' (feature 16, the yapin flag) -------------------------
# Server only, never NEXT_PUBLIC. Register the app at https://www.yapin.gg/developers
# with the redirect URI https://<your domain>/auth/yapin
# (http://localhost:3000/auth/yapin for npm run dev). Without all three,
# Continue with Yapin' and Settings > Connections are hidden and /auth/yapin
# answers 503 yapin_off.
YAPIN_CLIENT_ID=
YAPIN_CLIENT_SECRET=
# The Supabase secret key (or the legacy service_role key). Only Sign in with
# Yapin' uses it on the website, to sign in or make the account of a Yapin'
# user. It can read and change everything in the database: leave it empty
# unless you switch Sign in with Yapin' on. See docs/launch.md#yapin.
SUPABASE_SERVICE_ROLE_KEY=

# Only for the checks in scripts/yapin-shots.mjs: a local stand in for yapin.gg.
# Leave it empty.
YAPIN_BASE_URL=

# The encoder worker (worker/) has its own settings: see worker/.env.example.
